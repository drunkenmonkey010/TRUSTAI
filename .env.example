# =========================================================================
# Meridian Vendor AI Intelligence Engine - environment configuration
# Copy this file to `.env` and fill in only the keys you actually use.
# The application runs WITHOUT any keys (offline/demo mode).
# NEVER commit a real .env file. Secrets are never logged or displayed.
# =========================================================================

# ---- Primary public web search (recommended first connector) ----
BRAVE_SEARCH_API_KEY=

# ---- Optional alternative search provider ----
TAVILY_API_KEY=

# ---- Optional corporate identity enrichment ----
OPENCORPORATES_API_KEY=

# ---- SEC EDGAR identification (no key required, but a UA is mandatory) ----
# SEC requires a descriptive User-Agent with contact info for fair access.
SEC_USER_AGENT=MeridianVendorIntelligence/1.0
SEC_CONTACT_EMAIL=your_email@example.com

# ---- Optional infrastructure intelligence (all optional) ----
SECURITYTRAILS_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
SHODAN_API_KEY=

# ---- Hosted LLM (configure only the provider you use) ----
# Supported provider abstraction: "openai" or "none".
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- Database ----
MERIDIAN_DB_PATH=data/meridian.db

# ---- Request budgets / network behaviour ----
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3
CONNECTOR_RATE_LIMIT_PER_SEC=1.0
INVESTIGATION_QUERY_BUDGET=25
ENABLE_PROVIDER_FALLBACK=false

# ---- Public web retrieval etiquette ----
PUBLIC_WEB_USER_AGENT=MeridianVendorIntelligence/1.0 (+third-party-risk-research)
RESPECT_ROBOTS_TXT=true
